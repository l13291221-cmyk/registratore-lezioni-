# Copia questo file come ".env" (nella stessa cartella di bot.py) e compilalo.
# Serve solo se usi il programma sul tuo PC: su GitHub gli stessi valori
# vanno nei Secrets del repository (vedi README.md).

# --- La tua casella di posta --------------------------------------------
EMAIL_INDIRIZZO=tuonome@gmail.com
# Per Gmail: "password per le app" di 16 lettere, NON la password normale.
EMAIL_PASSWORD=abcd efgh ijkl mnop

# --- Quali email cercare (almeno uno dei due) ---------------------------
# Basta un pezzo: "sito.it" trova anche "Sito <noreply@sito.it>".
EMAIL_MITTENTE=noreply@sito.it
EMAIL_OGGETTO=Accedi al tuo account

# --- Quale link aprire (facoltativi, ma consigliati) --------------------
# Testo del pulsante/link nell'email, es. "Accedi".
LINK_TESTO=
# Un pezzo dell'indirizzo del link, es. "sito.it/login".
LINK_CONTIENE=

# --- Il tuo account sul sito (solo se il sito chiede utente e password) -
SITO_UTENTE=
SITO_PASSWORD=
# Obbligatorio con la password: viene scritta SOLO su questo sito.
SITO_DOMINIO=sito.it

# --- Opzioni avanzate (togli il # davanti per usarle) -----------------
# Server di posta: riconosciuto da solo per Gmail, Libero, Virgilio, Yahoo, iCloud.
# IMAP_SERVER=imap.gmail.com
# Cartella in cui arrivano le email.
# CARTELLA=INBOX
# Testo che compare sul sito solo quando sei dentro (es. "Esci" o il tuo nome).
# TESTO_SUCCESSO=Benvenuto
# Le email più vecchie di queste ore vengono ignorate.
# ORE_MASSIME=24
# Secondi di permanenza sulla pagina dopo l'accesso.
# ATTESA_SECONDI=5
# Solo se il login automatico non trova i campi giusti (selettori CSS).
# SELETTORE_UTENTE=#username
# SELETTORE_PASSWORD=#password
# SELETTORE_INVIO=button.login
